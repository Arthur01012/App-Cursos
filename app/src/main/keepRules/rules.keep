# Preservar atributos de reflexión, anotaciones y firmas genéricas
-keepattributes Signature, *Annotation*, InnerClasses, EnclosingMethod

# Preservar números de línea en los informes de errores/crashes
-renamesourcefileattribute SourceFile
-keepattributes SourceFile, LineNumberTable

# Mantener todas las clases de modelo y sus miembros para evitar errores al deserializar JSON
-keep class com.example.app_cursos.Modelo.** { *; }
-keepclassmembers class com.example.app_cursos.Modelo.** { *; }

# Reglas generales para Kotlinx Serialization
-keepclassmembers class * {
    @kotlinx.serialization.Serializable *;
}
-keepclassmembers class * {
    @kotlinx.serialization.SerialName *;
}
-keepclassmembers class *$$serializer { *; }
-keepclassmembers class * {
    *** Companion;
}

-keep interface com.example.app_cursos.InterfaceApi.** { *; }
-keepclassmembers class * {
    @retrofit2.http.* <methods>;
}
-dontwarn retrofit2.**

-dontwarn okhttp3.**
-dontwarn okio.**
-keepnames class okhttp3.internal.publicsuffix.PublicSuffixDatabase

-keep public class * extends com.bumptech.glide.module.AppGlideModule
-keep class * implements com.bumptech.glide.module.GlideModule
-keepclassmembers class * implements com.bumptech.glide.module.GlideModule {
    public <init>();
}
-dontwarn com.bumptech.glide.**
